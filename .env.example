# Copy this file to .env and fill in your values
# .env is gitignored

# NASA FIRMS API key — free at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_API_KEY=your_firms_api_key_here

# OpenAQ API key — optional; public endpoints work without it
OPENAQ_API_KEY=

# ── MLflow tracking ────────────────────────────────────────────────────────────
# Option A: local Docker (default for development)
MLFLOW_TRACKING_URI=http://localhost:5000

# Option B: DagsHub-hosted MLflow (use this when training to populate Render's registry)
# MLFLOW_TRACKING_URI=https://dagshub.com/sidparambi/wildfire-smoke-forecast.mlflow
# MLFLOW_TRACKING_USERNAME=sidparambi
# MLFLOW_TRACKING_PASSWORD=your_dagshub_token_here

# Path for Evidently drift report (used by FastAPI /drift-report endpoint)
DRIFT_REPORT_PATH=data/reports/drift_latest.html
